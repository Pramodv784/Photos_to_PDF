<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.PhotosToPDF" parent="Theme.Material3.Light.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:colorPrimary">@color/red</item>
        <item name="colorAccent">@color/red</item>
        <item name="android:spinnerDropDownItemStyle">@style/SpinnerTheme</item>
        <item name="android:statusBarColor">@color/color_background</item>
    </style>

    <style name="Theme.PhotosToPDF" parent="Base.Theme.PhotosToPDF" />

    <style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar">
        <item name="actionMenuTextColor">@color/white</item>
        <item name="colorControlNormal">@color/red</item>
    </style>

    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.AppCompat.Light">
        <item name="actionMenuTextColor">@color/white</item>
    </style>


    <style name="CustomAlertDialog" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="android:windowBackground">@drawable/rounded_corner</item>
    </style>

    <style name="CustomTextView" parent="@android:style/TextAppearance.Widget.TextView">
        <item name="android:background">@drawable/rounded_corner</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textSize">@dimen/_15sdp</item>
        <item name="android:padding">@dimen/_5sdp</item>
        <item name="fontFamily">@font/urbanist_semibold</item>
        <item name="android:textAlignment">center</item>
    </style>

    <style name="CustomButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/red_circle</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textSize">@dimen/_15sdp</item>
        <item name="android:padding">@dimen/_5sdp</item>
        <item name="android:textAlignment">center</item>
    </style>

    <style name="RoundedTabLayoutStyle" parent="Widget.Design.TabLayout">
        <item name="tabBackground">@drawable/tab_layout</item>
        <item name="tabIndicator">@null</item>
        <item name="android:background">@drawable/unselect_tab_layout_bg</item>
        <item name="tabSelectedTextColor">@color/white</item>
        <item name="tabTextColor">@color/color_dark_grey</item>
    </style>

    <style name="SpinnerTheme" parent="Theme.AppCompat.Light.Dialog">
        <item name="android:background">@drawable/custom_spinner_background</item>
        <item name="android:popupBackground">@drawable/dropdown_popup
        </item>

        <item name="android:textAlignment">textStart</item>
    </style>
    <style name="spinnerItemStyle" parent="android:Widget.TextView.SpinnerItem">

    </style>

    <style name="spinnerDropDownItemStyle" parent="android:TextAppearance.Widget.TextView.SpinnerItem">

    </style>
</resources>